{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reolink-rs",
  "version": "0.4.3",
  "identifier": "dev.reolink-rs.client",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Reolink-rs",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: http://127.0.0.1:* asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "Reolink-rs",
    "shortDescription": "Reolink camera client without the battery idle disconnect",
    "copyright": "AGPL-3.0-or-later",
    "resources": {
      "bundle/ffmpeg.exe": "ffmpeg.exe",
      "bundle/FFMPEG-LICENSE.txt": "FFMPEG-LICENSE.txt"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp"
      },
      "wix": {
        "bannerPath": "icons/wix-banner.bmp",
        "dialogImagePath": "icons/wix-dialog.bmp"
      }
    }
  }
}
