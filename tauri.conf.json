{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reolink-rs",
  "version": "0.1.0",
  "identifier": "dev.reolink-rs.client",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Reolink-rs", "width": 1360, "height": 860, "minWidth": 900, "minHeight": 560 }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' http://127.0.0.1:*; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": { "icon": ["icons/icon.ico", "icons/icon.png"] }
}
